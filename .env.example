# ── Access ──────────────────────────────────────────────
# Anyone opening your deployment must type this once (30-day cookie).
APP_PASSCODE=
# Random 32+ chars; signs the session cookie. `openssl rand -base64 32`
SESSION_SECRET=

# ── FedEx (developer.fedex.com → Basic Integrated Visibility) ─
FEDEX_API_KEY=
FEDEX_SECRET_KEY=
# Sandbox keys only work against the sandbox host:
# FEDEX_BASE_URL=https://apis-sandbox.fedex.com

# ── UPS (developer.ups.com → Tracking API) ───────────────
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
# UPS_BASE_URL=https://wwwcie.ups.com

# ── USPS (optional, experimental; not wired yet) ────────
USPS_CLIENT_ID=
USPS_CLIENT_SECRET=

# ── Local dev ───────────────────────────────────────────
# 1 = answer /api/track from server/fixtures (no keys needed)
PG_FIXTURES=
